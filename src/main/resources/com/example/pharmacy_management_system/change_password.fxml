<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="500.0" style="-fx-background-color: #f5f6fa;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pharmacy_management_system.PasswordController">
    <children>
        <Label layoutX="140.0" layoutY="40.0" text="Change Password" textFill="#2f3640">
            <font><Font name="System Bold" size="24.0" /></font>
        </Label>

        <Label layoutX="100.0" layoutY="110.0" text="Current Password:" />
        <PasswordField fx:id="current_pass" layoutX="100.0" layoutY="130.0" prefHeight="30.0" prefWidth="300.0" />

        <Label layoutX="100.0" layoutY="180.0" text="New Password:" />
        <PasswordField fx:id="new_pass" layoutX="100.0" layoutY="200.0" prefHeight="30.0" prefWidth="300.0" />

        <Button layoutX="100.0" layoutY="270.0" onAction="#updatePassword" prefHeight="40.0" prefWidth="300.0" style="-fx-background-color: #4834d4;" text="Update Password" textFill="WHITE">
            <font><Font name="System Bold" size="14.0" /></font>
        </Button>

        <Button layoutX="100.0" layoutY="330.0" onAction="#backToDashboard" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #dcdde1;" text="Cancel" />
    </children>
</AnchorPane>
