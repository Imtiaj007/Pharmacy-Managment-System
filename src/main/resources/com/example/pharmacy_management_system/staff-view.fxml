<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pharmacy_management_system.StaffController">
    <children>
        <AnchorPane prefHeight="600.0" prefWidth="300.0" style="-fx-background-color: #d1d8e0;">
            <children>
                <Label layoutX="20.0" layoutY="30.0" text="Staff Details" textFill="#2d3436">
                    <font><Font name="System Bold" size="22.0" /></font>
                </Label>
                <TextField fx:id="staff_name" layoutX="20.0" layoutY="100.0" prefHeight="30.0" prefWidth="250.0" promptText="Full Name" />
                <TextField fx:id="staff_pos" layoutX="20.0" layoutY="150.0" prefHeight="30.0" prefWidth="250.0" promptText="Position (e.g. Pharmacist)" />
                <TextField fx:id="staff_phone" layoutX="20.0" layoutY="200.0" prefHeight="30.0" prefWidth="250.0" promptText="Phone Number" />
                <TextField fx:id="staff_salary" layoutX="20.0" layoutY="250.0" prefHeight="30.0" prefWidth="250.0" promptText="Salary" />

                <Button layoutX="20.0" layoutY="320.0" onAction="#addStaff" prefHeight="40.0" prefWidth="250.0" style="-fx-background-color: #20bf6b;" text="Add Staff" textFill="WHITE">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
                <Button layoutX="20.0" layoutY="375.0" onAction="#clearFields" prefHeight="30.0" prefWidth="250.0" style="-fx-background-color: #4b6584;" text="Clear Fields" textFill="WHITE" />
            </children>
        </AnchorPane>

        <TextField fx:id="staff_search" layoutX="320.0" layoutY="30.0" onKeyTyped="#searchStaff" prefHeight="35.0" prefWidth="400.0" promptText="🔍 Search Staff by Name or Position..." style="-fx-background-radius: 20; -fx-padding: 0 0 0 15;" />

        <TableView fx:id="staffTable" layoutX="320.0" layoutY="85.0" prefHeight="485.0" prefWidth="550.0">
            <columns>
                <TableColumn fx:id="col_name" prefWidth="180.0" text="Name" />
                <TableColumn fx:id="col_pos" prefWidth="150.0" text="Position" />
                <TableColumn fx:id="col_phone" prefWidth="120.0" text="Phone" />
                <TableColumn fx:id="col_salary" prefWidth="98.0" text="Salary" />
            </columns>
        </TableView>
    </children>
</AnchorPane>
